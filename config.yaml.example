port: "8080"
zip_dir: "./publish"

auth:
  enabled: true
  client_id: "YOUR_GOOGLE_CLIENT_ID"
  client_secret: "YOUR_GOOGLE_CLIENT_SECRET"
  redirect_url: "http://localhost:8080/_/callback"
  allowed_users:
    - "*@company.com"
    - "user@thirdparty.com"
  session_key: "super-secret-session-key"
  # cookie_secure: false # Set to false if running behind an HTTP reverse proxy that terminates TLS

upload:
  enabled: true
  token: "your-secret-upload-token" # for Bearer authentication

comments:
  dir: "./comments"
  scope: "version" # options: "version" (comments per version), "book" (comments shared across versions)

notifications:
  enabled: true
  base_url: "http://localhost:8080"
  smtp:
    host: "smtp.example.com"
    port: 587
    username: "noreply@example.com"
    password: "smtp-password"
    from: "Zipserver <noreply@example.com>"
    tls: "starttls" # encryption policy: "none", "starttls", "ssl" (implicit TLS), or leave empty for port-based auto-detection
    skip_verify: false # set to true to bypass certificate verification (e.g. for self-signed certificates)
    hello: "" # HELO/EHLO domain name. If empty, auto-detected from base_url or sender email
  watchers:
    - "admin@example.com"

